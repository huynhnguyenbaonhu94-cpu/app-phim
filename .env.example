# Mẫu biến môi trường cho Cinemora (không chứa khoá thật).
# Trên cPanel: Setup Node.js App → Environment Variables (hoặc tạo tệp .env cạnh package.json).

# --- Bắt buộc ---
DATABASE_URL=mysql://user:password@localhost:3306/database

# --- Tìm diễn viên trong "Thêm phim thủ công" (không bắt buộc) ---
# Điền API Key (v3) hoặc API Read Access Token (v4) lấy từ themoviedb.org → Settings → API.
# Bỏ trống thì hệ thống tự dùng Wikidata (miễn phí), vẫn có tên và ảnh diễn viên.
TMDB_API_KEY=
