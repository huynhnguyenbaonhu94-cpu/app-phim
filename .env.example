# Mẫu biến môi trường cho Cinemora (không chứa khoá thật).
# Trên cPanel: Setup Node.js App → Environment Variables (hoặc tạo tệp .env cạnh package.json).

# --- Bắt buộc ---
DATABASE_URL=mysql://user:password@localhost:3306/database

# --- Tìm diễn viên trong "Thêm phim thủ công" (không bắt buộc) ---
# Điền API Key (v3) hoặc API Read Access Token (v4) lấy từ themoviedb.org → Settings → API.
# Bỏ trống thì hệ thống tự dùng Wikidata (miễn phí), vẫn có tên và ảnh diễn viên.
TMDB_API_KEY=

# --- Cloudflare R2 (tuỳ chọn; có thể cấu hình tại /admin/r2-settings) ---
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=cinemora-private
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
# Tạo bằng `openssl rand -base64 48`, tối thiểu 32 byte. Bắt buộc khi lưu credentials R2 trong DB.
# Giữ khóa ổn định; thay khóa sau khi lưu credentials sẽ khiến server không giải mã được chúng.
# R2_SETTINGS_ENCRYPTION_KEY=
# LOCAL_PRIVATE_UPLOAD_DIR=/var/lib/cinemora/private-uploads
